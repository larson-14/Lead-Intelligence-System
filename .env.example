# Copy to .env. Never include .env in a submission ZIP.
# Use the provider/model identifier supported by your provider account and LiteLLM.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_BATCH_SIZE=10
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Enable only if your selected provider/model supports JSON-object response mode.
LLM_JSON_MODE=false
